% cryptocode defines a command called \procedure (the "header + body" pseudocode
% macro that is used throughout the cryptocode manual).  algorithm2e, loaded
% further below, defines an *environment* with the same name via
% \newenvironment, which refuses to overwrite an existing \procedure and aborts
% with "LaTeX Error: Command \procedure already defined."
% cryptocode uses a plain \gdef, so it silently wins (or, depending on the load
% order, silently destroys algorithm2e's environment).
% Fix: park cryptocode's \procedure in \notes@pc@procedure and free the name so
% that algorithm2e can define its environment; the latter is then re-exposed
% below as the `algprocedure' environment and \procedure is handed back to
% cryptocode.  See the "Algorithm Env" section for the other half.
\usepackage{cryptocode}
\makeatletter
\let\notes@pc@procedure\procedure
\let\procedure\relax
\makeatother

